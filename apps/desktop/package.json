{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "author": "Dezign2App Team",
  "description": "D2A",
  "main": "dist-electron/main.js",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "dev": "tsc -p tsconfig.electron.json && electron .",
    "build:electron": "node scripts/build.js --prod",
    "build:electron:prod": "node scripts/build.js --prod",
    "build:electron:prod:win": "node scripts/build.js --prod --win",
    "build:electron:prod:win:x64": "node scripts/build.js --prod --win --x64",
    "build:electron:prod:dir": "node scripts/build.js --prod --dir",
    "build:electron:dev": "node scripts/build.js --dev",
    "build:electron:dev:win": "node scripts/build.js --dev --win",
    "build:electron:dev:win:x64": "node scripts/build.js --dev --win --x64",
    "build:electron:dev:dir": "node scripts/build.js --dev --dir",
    "build:electron:win": "node scripts/build.js --prod --win",
    "build:electron:win:x64": "node scripts/build.js --prod --win --x64",
    "build:electron:win:ia32": "node scripts/build.js --prod --win --ia32",
    "build:electron:win:x32": "node scripts/build.js --prod --win --ia32",
    "build:electron:mac": "node scripts/build.js --prod --mac",
    "build:electron:linux": "node scripts/build.js --prod --linux",
    "build:electron:all": "node scripts/build.js --prod --all",
    "build:electron:dir": "node scripts/build.js --prod --dir",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^34.5.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.dezign2app.desktop",
    "productName": "D2A",
    "icon": "build/icon.ico",
    "protocols": [
      {
        "name": "D2A",
        "schemes": [
          "dezign2app"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "subhash131",
        "repo": "dezign2app"
      }
    ],
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "build-web",
        "to": "web"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "D2A",
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  }
}
