# ==============================================================================
# Dezign2App Web Application - Production Environment Example
# Copy this file to .env.production on production servers or configure these
# in your deployment platform (Vercel / AWS / Docker / etc.)
# ==============================================================================

# Convex Production Cloud & Site URLs
NEXT_PUBLIC_CONVEX_URL=https://your-production-instance.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-production-instance.convex.site
CONVEX_URL=https://your-production-instance.convex.cloud
CONVEX_SITE_URL=https://your-production-instance.convex.site

# Better Auth & Application URLs for Production
BETTER_AUTH_SECRET=your-production-better-auth-secret-min-32-chars
BETTER_AUTH_URL=https://www.dezign2app.com
NEXT_PUBLIC_APP_URL=https://www.dezign2app.com
NEXT_PUBLIC_DESKTOP_AUTH_URL=https://www.dezign2app.com
BETTER_AUTH_TRUSTED_ORIGINS=https://dezign2app.com,https://www.dezign2app.com,dezign2app://

# Microservices URLs (Production)
NEXT_PUBLIC_WORKFLOW_ENGINE_BASE_URL=https://workflow.dezign2app.com
NEXT_PUBLIC_SYSTEM_DESIGN_ENGINE_URL=https://engine.dezign2app.com

# OAuth Providers (Production credentials)
GITHUB_CLIENT_ID=your-prod-github-client-id
GITHUB_CLIENT_SECRET=your-prod-github-client-secret
GOOGLE_CLIENT_ID=your-prod-google-client-id
GOOGLE_CLIENT_SECRET=your-prod-google-client-secret

# Email & Notifications (Resend)
RESEND_API_KEY=re_your_prod_resend_api_key
RESEND_API_URL=https://api.resend.com
EMAIL_FROM=notifications@dezign2app.com

# Payments & Billing (Creem Live)
CREEM_API_KEY=creem_live_your_api_key
TEST_MODE=false
NEXT_PUBLIC_BETA_PRODUCT_ID=prod_live_product_id

# Redis / Upstash (Production Cluster)
UPSTASH_REDIS_REST_URL=https://your-prod-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_prod_token_here

# AI / Groq
GROQ_API_KEY=gsk_your_groq_api_key
NEXT_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key

# Logging Configuration
LOG=false
LOG_LEVEL=error
NEXT_PUBLIC_LOG=false
NEXT_PUBLIC_LOG_LEVEL=error
