# ==============================================================================
# Dezign2App Web Application - Environment Variables Example
# Copy this file to .env.local for local overrides
# ==============================================================================

# Convex Backend
NEXT_PUBLIC_CONVEX_URL=https://neighborly-setter-541.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://neighborly-setter-541.convex.site

# Better Auth Configuration
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:46500
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:46500,https://dezign2app.com,dezign2app://

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:46500
NEXT_PUBLIC_DESKTOP_AUTH_URL=http://localhost:46500
NEXT_PUBLIC_WORKFLOW_ENGINE_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SYSTEM_DESIGN_ENGINE_URL=http://localhost:3002

# OAuth Providers (GitHub & Google)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email & Notifications (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Payments & Billing (Creem)
CREEM_API_KEY=creem_test_your_api_key
TEST_MODE=true
NEXT_PUBLIC_BETA_PRODUCT_ID=prod_3SqZz0dwcsNP45v1pDXguW
NEXT_PUBLIC_CREEM_PAYMENT_URL=https://www.creem.io/payment/prod_3SqZz0dwcsNP45v1pDXguW

# Redis / Upstash
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# AI / Groq
GROQ_API_KEY=gsk_your_groq_api_key

# Logging Configuration
# LOG=true enables all logs (debug level); LOG=false silences all logs.
# LOG_LEVEL options: debug | info | warn | error | silent (default: error)
LOG=false
LOG_LEVEL=error
NEXT_PUBLIC_LOG=false
NEXT_PUBLIC_LOG_LEVEL=error