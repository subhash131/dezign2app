{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dezign2app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://dezign2app.com,https://www.dezign2app.com,dezign2app://",
    "BETTER_AUTH_URL": "https://dezign2app.com",
    "CONVEX_SITE_URL": "https://gregarious-quail-82.convex.site",
    "CONVEX_URL": "https://gregarious-quail-82.convex.cloud",
    "NEXT_PUBLIC_APP_URL": "https://dezign2app.com",
    "NEXT_PUBLIC_CONVEX_SITE_URL": "https://gregarious-quail-82.convex.site",
    "NEXT_PUBLIC_CONVEX_URL": "https://gregarious-quail-82.convex.cloud",
    "NEXT_PUBLIC_DESKTOP_AUTH_URL": "https://dezign2app.com",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "NODE_VERSION": "22",
    "TEST_MODE": "false"
  }
}
