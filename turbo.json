{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "CONVEX_DEPLOYMENT",
    "CONVEX_URL",
    "CONVEX_SITE_URL",
    "CONVEX_DEPLOY_KEY",
    "GROQ_API_KEY",
    "GROQ_LLM_MODEL",
    "GOOGLE_API_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "CREEM_API_KEY",
    "CREEM_SUBSCRIPTION_WEBHOOK_SECRET",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "TEST_MODE",
    "CLERK_SECRET_KEY",
    "LOG",
    "LOG_LEVEL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@workspace/canvas#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workspace/logger#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@workspace/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["convex/_generated/**"]
    },
    "system-design-engine#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "workflow-engine#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "electron:dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:e2e:watch": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    }
  }
}
