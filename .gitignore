# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Environment files (all .env files and variants except .example files)
.env
.env.*
.env*.local
!.env.example
!.env*.example

# Testing
coverage
playwright-report
test-results
blob-report
playwright/.cache
*.txt
!apps/web/public/*.txt
*.log
e2e_results.json

# Turbo
.turbo

# Vercel
.vercel

# Cloudflare Wrangler & OpenNext
.wrangler/
.open-next/

# Build Outputs
.next/
out/
build
dist
.source/
.next-build-env.json

# Electron build outputs (never commit these — they go to GitHub Releases via CI)
dist-electron/
apps/desktop/release/
apps/desktop/dist-electron/

# Debug
npm-debug.log*

# Misc
.DS_Store
*.pem

# Agent checkpoint data
agent-checkpoints.json

